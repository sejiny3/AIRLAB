<?xml version="1.0" encoding="utf-8"?>
<!--
UNBOLT world: a 7 m x 6 m room with a partition wall and a few obstacles for
LiDAR/SLAM, a work table with a red box, and the UNBOLT robot at the origin.
All static world geoms are in group 0, so the bridge's LiDAR (which only sees
groups 0-1) ignores the robot's own body (groups 2-3).
-->
<mujoco model="unbolt_scene">
  <compiler angle="radian"/>
  <option timestep="0.001" integrator="implicitfast" cone="elliptic" impratio="10"/>
  <statistic center="0.6 0 0.6" extent="2.0" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-20" offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.55 0.55 0.58" rgb2="0.2 0.2 0.2" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.38 0.38 0.4" rgb2="0.3 0.3 0.32"
             markrgb="0.6 0.6 0.6" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <!-- ArUco DICT_4X4_50 markers (models/make_markers.py); the marker fills 3/4 of the texture -->
    <texture type="2d" name="aruco_7" file="textures/aruco_7.png"/>
    <texture type="2d" name="aruco_3" file="textures/aruco_3.png"/>
    <texture type="2d" name="aruco_5" file="textures/aruco_5.png"/>
    <material name="aruco_7" texture="aruco_7"/>
    <material name="aruco_3" texture="aruco_3"/>
    <material name="aruco_5" texture="aruco_5"/>
    <model name="unbolt_robot" file="unbolt_robot.xml"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction="1 0.01 0.01"/>
    <camera name="overview" pos="3.9 -2.7 2.8" xyaxes="0.57 0.82 0 -0.4 0.28 0.87" fovy="60"/>
    <camera name="top" pos="1.0 0 9.0" xyaxes="1 0 0 0 1 0" fovy="45"/>

    <attach model="unbolt_robot" prefix=""/>

    <!-- room: x in [-2.5, 4.5], y in [-3, 3], walls 1 m high -->
    <body name="room">
      <geom name="wall_north" type="box" size="3.6 0.05 0.5" pos="1.0 3.05 0.5" rgba="0.75 0.75 0.78 1"/>
      <geom name="wall_south" type="box" size="3.6 0.05 0.5" pos="1.0 -3.05 0.5" rgba="0.75 0.75 0.78 1"/>
      <geom name="wall_east" type="box" size="0.05 3.0 0.5" pos="4.55 0 0.5" rgba="0.75 0.75 0.78 1"/>
      <geom name="wall_west" type="box" size="0.05 3.0 0.5" pos="-2.55 0 0.5" rgba="0.75 0.75 0.78 1"/>
      <!-- partition wall with a 1.2 m doorway at y in [-0.4, 0.8] -->
      <geom name="partition_a" type="box" size="0.05 1.1 0.5" pos="-1.2 1.9 0.5" rgba="0.68 0.68 0.72 1"/>
      <geom name="partition_b" type="box" size="0.05 1.3 0.5" pos="-1.2 -1.7 0.5" rgba="0.68 0.68 0.72 1"/>
      <!-- obstacles -->
      <geom name="shelf" type="box" size="0.4 0.2 0.6" pos="0.8 2.6 0.6" rgba="0.45 0.35 0.25 1"/>
      <geom name="pillar" type="cylinder" size="0.15 0.5" pos="1.0 -1.6 0.5" rgba="0.6 0.6 0.65 1"/>
      <geom name="crate_1" type="box" size="0.25 0.25 0.25" pos="3.6 -2.3 0.25" rgba="0.55 0.42 0.2 1"/>
      <geom name="crate_2" type="box" size="0.2 0.3 0.3" pos="3.7 2.2 0.3" euler="0 0 0.5" rgba="0.55 0.42 0.2 1"/>
      <geom name="bin" type="cylinder" size="0.2 0.35" pos="-2.0 -2.4 0.35" rgba="0.2 0.4 0.6 1"/>
    </body>

    <!-- Tables: top surface at z = 0.65, where the arms reach best with a forward
         grasp. The robot's chassis (0.19 m tall) fits under the 0.61 m underside,
         so it can drive its front edge under the table top. -->
    <!-- work table = place destination; marker 3 marks the place spot -->
    <body name="work_table" pos="2.2 0 0.325">
      <geom name="work_table_top" type="box" size="0.35 0.5 0.02" pos="0 0 0.305" rgba="0.82 0.71 0.55 1"/>
      <geom name="work_table_leg1" type="box" size="0.02 0.02 0.305" pos="0.31 0.46 0" rgba="0.5 0.4 0.3 1"/>
      <geom name="work_table_leg2" type="box" size="0.02 0.02 0.305" pos="0.31 -0.46 0" rgba="0.5 0.4 0.3 1"/>
      <geom name="work_table_leg3" type="box" size="0.02 0.02 0.305" pos="-0.31 0.46 0" rgba="0.5 0.4 0.3 1"/>
      <geom name="work_table_leg4" type="box" size="0.02 0.02 0.305" pos="-0.31 -0.46 0" rgba="0.5 0.4 0.3 1"/>
      <geom name="place_pad" type="box" size="0.05 0.05 0.0005" pos="-0.2 -0.15 0.3255" material="aruco_3" contype="0" conaffinity="0"/>
    </body>

    <!-- supply table = where the red box starts. 0.8 m wide so its legs stay outside
         the base when the robot grasps with the right arm (base centred on the table,
         box 0.15 m to its right). -->
    <body name="supply_table" pos="-0.15 -2.45 0.325">
      <geom name="supply_table_top" type="box" size="0.40 0.25 0.02" pos="0 0 0.305" rgba="0.62 0.74 0.82 1"/>
      <geom name="supply_table_leg1" type="box" size="0.02 0.02 0.305" pos="0.36 0.21 0" rgba="0.35 0.45 0.55 1"/>
      <geom name="supply_table_leg2" type="box" size="0.02 0.02 0.305" pos="0.36 -0.21 0" rgba="0.35 0.45 0.55 1"/>
      <geom name="supply_table_leg3" type="box" size="0.02 0.02 0.305" pos="-0.36 0.21 0" rgba="0.35 0.45 0.55 1"/>
      <geom name="supply_table_leg4" type="box" size="0.02 0.02 0.305" pos="-0.36 -0.21 0" rgba="0.35 0.45 0.55 1"/>
      <!-- place pad (marker 5) under the box's starting spot, for putting it back -->
      <geom name="supply_pad" type="box" size="0.05 0.05 0.0005" pos="-0.15 0.09 0.3255" material="aruco_5" contype="0" conaffinity="0"/>
    </body>

    <!-- red box (5 cm cube, 100 g) with marker 7 on its top face -->
    <body name="red_box" pos="-0.3 -2.36 0.676">
      <freejoint name="red_box_free"/>
      <geom name="red_box" type="box" size="0.025 0.025 0.025" mass="0.1" rgba="0.9 0.1 0.1 1" friction="1.2 0.01 0.01"/>
      <geom name="red_box_marker" type="box" size="0.025 0.025 0.0005" pos="0 0 0.0255" material="aruco_7" contype="0" conaffinity="0" mass="0"/>
    </body>
  </worldbody>
</mujoco>
