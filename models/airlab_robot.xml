<?xml version="1.0" encoding="utf-8"?>
<!--
AIRLAB mobile bimanual robot: differential-drive base + torso column +
OpenArm v2 bimanual arms (attached from third_party/openarm_mujoco).

Attach it from a scene:
  <asset><model name="airlab_robot" file="airlab_robot.xml"/></asset>
  <worldbody><attach model="airlab_robot" prefix=""/></worldbody>

Frames (ROS REP-105 style):
  base_link      : chassis body, origin on the wheel axle, x forward, z up
  base_footprint : projection of base_link on the floor (site, z = -wheel_radius)
  lidar_link     : 2D LiDAR mount site (used from step 2)
-->
<mujoco model="airlab_robot">
  <compiler angle="radian"/>
  <option timestep="0.001" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <default>
    <default class="base_visual">
      <geom contype="0" conaffinity="0" group="2"/>
    </default>
    <default class="base_collision">
      <geom condim="3" contype="1" conaffinity="1" group="3" friction="1 0.01 0.01"/>
    </default>
    <default class="wheel">
      <!-- sphere collision gives one stable contact point (cylinder rims chatter) -->
      <geom type="sphere" size="0.08" condim="3" friction="1.5 0.02 0.002"
            contype="1" conaffinity="1" group="3"/>
      <joint type="hinge" axis="0 1 0" damping="0.05" armature="0.01"/>
      <default class="wheel_visual">
        <geom type="cylinder" size="0.08 0.025" contype="0" conaffinity="0" group="2" rgba="0.12 0.12 0.12 1"/>
      </default>
    </default>
    <default class="caster">
      <!-- frictionless sphere = ideal omni caster; soft contact acts as a
           suspension so the drive wheels keep most of the load. priority makes
           the caster's condim/friction win over the floor's: by default MuJoCo
           takes the max condim of the pair, which turns the caster into a skid
           that stalls slow in-place turns. -->
      <geom type="sphere" size="0.03" condim="1" priority="2" friction="0 0 0" contype="1" conaffinity="1" solref="0.08 1" rgba="0.5 0.5 0.5 1"/>
    </default>
  </default>

  <asset>
    <material name="chassis_mat" rgba="0.92 0.45 0.62 1" specular="0.3" shininess="0.3"/>
    <material name="pedestal_mat" rgba="0.247 0.247 0.247 1.0" reflectance="0.05" shininess="0.5"/>
    <mesh name="pedestal_visual" file="../third_party/openarm_mujoco/v2/assets/visual/body/body_link0.stl" scale="0.001 0.001 0.001"/>
    <mesh name="pedestal_collision" file="../third_party/openarm_mujoco/v2/assets/collision/body_link0_symp.stl" scale="0.001 0.001 0.001"/>
    <model name="bimanual" file="../third_party/openarm_mujoco/v2/openarm_bimanual.xml"/>
  </asset>

  <worldbody>
    <body name="base_link" pos="0 0 0.08">
      <freejoint name="base_free"/>
      <site name="base_footprint" pos="0 0 -0.08" size="0.01" group="4"/>

      <!-- chassis -->
      <geom name="chassis_visual" type="box" size="0.27 0.19 0.06" pos="0 0 0.05" class="base_visual" material="chassis_mat"/>
      <geom name="chassis_collision" type="box" size="0.27 0.19 0.06" pos="0 0 0.05" class="base_collision" mass="25"/>
      <!-- OpenArm v2 pedestal (body_link0) on the chassis top. The URDF uses the
           same frame: base_link -> openarm_body_mount (-0.05, 0, 0.11). -->
      <frame pos="-0.05 0 0.11">
        <geom name="pedestal_visual" type="mesh" mesh="pedestal_visual" class="base_visual" material="pedestal_mat"/>
        <geom name="pedestal_collision" type="mesh" mesh="pedestal_collision" class="base_collision" mass="4"/>
        <!-- shoulders: OpenArm bimanual mount point (body reference point z = 0.697) -->
        <frame pos="0 0 0.697">
          <attach model="bimanual" prefix=""/>
        </frame>
      </frame>

      <!-- casters (front / rear), 3 mm above the floor at rest like a real
           diff-drive base: if they touched along with the wheels the base
           would be over-constrained and the wheels lose traction -->
      <geom name="caster_front" class="caster" pos="0.22 0 -0.047"/>
      <geom name="caster_rear" class="caster" pos="-0.22 0 -0.047"/>

      <!-- drive wheels: +y = left. Positive rotation about +y drives forward. -->
      <body name="left_wheel_link" pos="0 0.225 0">
        <joint name="left_wheel_joint" class="wheel"/>
        <geom name="left_wheel" class="wheel" mass="1.0"/>
        <geom name="left_wheel_visual" class="wheel_visual" zaxis="0 1 0"/>
      </body>
      <body name="right_wheel_link" pos="0 -0.225 0">
        <joint name="right_wheel_joint" class="wheel"/>
        <geom name="right_wheel" class="wheel" mass="1.0"/>
        <geom name="right_wheel_visual" class="wheel_visual" zaxis="0 1 0"/>
      </body>

      <!-- sensors mounts -->
      <site name="lidar_link" pos="0.22 0 0.13" size="0.03" rgba="0.1 0.1 0.1 1"/>
      <site name="imu_link" pos="0 0 0.05" size="0.01" group="4"/>
      <!-- head camera above the shoulders, pitched 47 deg down (URDF: camera_link).
           MuJoCo cameras look along -z with +y up: xaxis = -y_link, yaxis = z_link. -->
      <camera name="head_camera" pos="0.05 0 0.97" xyaxes="0 -1 0 0.731 0 0.682" fovy="60" resolution="1280 720"/>
    </body>
  </worldbody>

  <contact>
    <!-- column and arm bases overlap by construction at the mount -->
    <exclude body1="base_link" body2="openarm_left_base_link"/>
    <exclude body1="base_link" body2="openarm_right_base_link"/>
  </contact>

  <actuator>
    <velocity name="left_wheel_vel" joint="left_wheel_joint" kv="8" forcerange="-25 25" forcelimited="true" ctrlrange="-20 20" ctrllimited="true"/>
    <velocity name="right_wheel_vel" joint="right_wheel_joint" kv="8" forcerange="-25 25" forcelimited="true" ctrlrange="-20 20" ctrllimited="true"/>
  </actuator>

  <sensor>
    <gyro name="imu_gyro" site="imu_link"/>
    <accelerometer name="imu_accel" site="imu_link"/>
    <framequat name="imu_quat" objtype="site" objname="imu_link"/>
  </sensor>
</mujoco>
