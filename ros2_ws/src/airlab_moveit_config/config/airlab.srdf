<?xml version='1.0' encoding='UTF-8'?>
<robot name="airlab">
  <group name="left_arm">
    <chain base_link="openarm_left_base_link" tip_link="openarm_left_grasp_frame" />
  </group>
  <group name="right_arm">
    <chain base_link="openarm_right_base_link" tip_link="openarm_right_grasp_frame" />
  </group>
  <group name="both_arms">
    <group name="left_arm" />
    <group name="right_arm" />
  </group>
  <group name="left_gripper">
    <link name="openarm_left_ee_link1" />
    <link name="openarm_left_ee_link2" />
    <joint name="openarm_left_finger_joint1" />
    <joint name="openarm_left_finger_joint2" />
  </group>
  <group name="right_gripper">
