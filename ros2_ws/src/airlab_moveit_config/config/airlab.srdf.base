<?xml version="1.0" encoding="UTF-8"?>
<!--
Hand-written part of the SRDF. config/airlab.srdf = this file + <disable_collisions>
generated by scripts/generate_srdf.sh (moveit_setup_assistant collisions_updater).
Edit this file, then regenerate; do not edit airlab.srdf directly.
-->
<robot name="airlab">
  <group name="left_arm">
    <chain base_link="openarm_left_base_link" tip_link="openarm_left_grasp_frame"/>
  </group>
  <group name="right_arm">
    <chain base_link="openarm_right_base_link" tip_link="openarm_right_grasp_frame"/>
  </group>
  <group name="both_arms">
    <group name="left_arm"/>
    <group name="right_arm"/>
  </group>
  <group name="left_gripper">
    <link name="openarm_left_ee_link1"/>
    <link name="openarm_left_ee_link2"/>
    <joint name="openarm_left_finger_joint1"/>
    <joint name="openarm_left_finger_joint2"/>
  </group>
  <group name="right_gripper">
    <link name="openarm_right_ee_link1"/>
    <link name="openarm_right_ee_link2"/>
    <joint name="openarm_right_finger_joint1"/>
    <joint name="openarm_right_finger_joint2"/>
  </group>

  <!-- home = elbows at 90 deg (the pose the simulator starts in) -->
  <group_state name="home" group="left_arm">
    <joint name="openarm_left_joint1" value="0"/>
    <joint name="openarm_left_joint2" value="0"/>
    <joint name="openarm_left_joint3" value="0"/>
    <joint name="openarm_left_joint4" value="1.5708"/>
    <joint name="openarm_left_joint5" value="0"/>
    <joint name="openarm_left_joint6" value="0"/>
    <joint name="openarm_left_joint7" value="0"/>
  </group_state>
  <group_state name="home" group="right_arm">
    <joint name="openarm_right_joint1" value="0"/>
    <joint name="openarm_right_joint2" value="0"/>
    <joint name="openarm_right_joint3" value="0"/>
    <joint name="openarm_right_joint4" value="1.5708"/>
    <joint name="openarm_right_joint5" value="0"/>
    <joint name="openarm_right_joint6" value="0"/>
    <joint name="openarm_right_joint7" value="0"/>
  </group_state>
  <group_state name="home" group="both_arms">
    <joint name="openarm_left_joint1" value="0"/>
    <joint name="openarm_left_joint2" value="0"/>
    <joint name="openarm_left_joint3" value="0"/>
    <joint name="openarm_left_joint4" value="1.5708"/>
    <joint name="openarm_left_joint5" value="0"/>
    <joint name="openarm_left_joint6" value="0"/>
    <joint name="openarm_left_joint7" value="0"/>
    <joint name="openarm_right_joint1" value="0"/>
    <joint name="openarm_right_joint2" value="0"/>
    <joint name="openarm_right_joint3" value="0"/>
    <joint name="openarm_right_joint4" value="1.5708"/>
    <joint name="openarm_right_joint5" value="0"/>
    <joint name="openarm_right_joint6" value="0"/>
    <joint name="openarm_right_joint7" value="0"/>
  </group_state>
  <!-- ready = forearms reaching forward over a table in front of the base -->
  <group_state name="ready" group="both_arms">
    <joint name="openarm_left_joint1" value="-0.6"/>
    <joint name="openarm_left_joint2" value="-0.1"/>
    <joint name="openarm_left_joint3" value="0"/>
    <joint name="openarm_left_joint4" value="1.2"/>
    <joint name="openarm_left_joint5" value="0"/>
    <joint name="openarm_left_joint6" value="0"/>
    <joint name="openarm_left_joint7" value="0"/>
    <joint name="openarm_right_joint1" value="0.6"/>
    <joint name="openarm_right_joint2" value="0.1"/>
    <joint name="openarm_right_joint3" value="0"/>
    <joint name="openarm_right_joint4" value="1.2"/>
    <joint name="openarm_right_joint5" value="0"/>
    <joint name="openarm_right_joint6" value="0"/>
    <joint name="openarm_right_joint7" value="0"/>
  </group_state>
  <!-- tuck = elbows folded, hands raised: keeps the hands above a 0.65 m table top
       while the base drives under its edge, and out of the head camera's view -->
  <group_state name="tuck" group="both_arms">
    <joint name="openarm_left_joint1" value="0"/>
    <joint name="openarm_left_joint2" value="0"/>
    <joint name="openarm_left_joint3" value="0"/>
    <joint name="openarm_left_joint4" value="2.3"/>
    <joint name="openarm_left_joint5" value="0"/>
    <joint name="openarm_left_joint6" value="0"/>
    <joint name="openarm_left_joint7" value="0"/>
    <joint name="openarm_right_joint1" value="0"/>
    <joint name="openarm_right_joint2" value="0"/>
    <joint name="openarm_right_joint3" value="0"/>
    <joint name="openarm_right_joint4" value="2.3"/>
    <joint name="openarm_right_joint5" value="0"/>
    <joint name="openarm_right_joint6" value="0"/>
    <joint name="openarm_right_joint7" value="0"/>
  </group_state>
  <group_state name="tuck" group="left_arm">
    <joint name="openarm_left_joint1" value="0"/>
    <joint name="openarm_left_joint2" value="0"/>
    <joint name="openarm_left_joint3" value="0"/>
    <joint name="openarm_left_joint4" value="2.3"/>
    <joint name="openarm_left_joint5" value="0"/>
    <joint name="openarm_left_joint6" value="0"/>
    <joint name="openarm_left_joint7" value="0"/>
  </group_state>
  <group_state name="tuck" group="right_arm">
    <joint name="openarm_right_joint1" value="0"/>
    <joint name="openarm_right_joint2" value="0"/>
    <joint name="openarm_right_joint3" value="0"/>
    <joint name="openarm_right_joint4" value="2.3"/>
    <joint name="openarm_right_joint5" value="0"/>
    <joint name="openarm_right_joint6" value="0"/>
    <joint name="openarm_right_joint7" value="0"/>
  </group_state>
  <!-- fingertip gap: 0 rad = 3.6 cm, |0.6| rad = 11.5 cm -->
  <group_state name="open" group="left_gripper">
    <joint name="openarm_left_finger_joint1" value="0.6"/>
  </group_state>
  <group_state name="closed" group="left_gripper">
    <joint name="openarm_left_finger_joint1" value="0"/>
  </group_state>
  <group_state name="open" group="right_gripper">
    <joint name="openarm_right_finger_joint1" value="-0.6"/>
  </group_state>
  <group_state name="closed" group="right_gripper">
    <joint name="openarm_right_finger_joint1" value="0"/>
  </group_state>

  <end_effector name="left_hand" parent_link="openarm_left_ee_base_link" group="left_gripper" parent_group="left_arm"/>
  <end_effector name="right_hand" parent_link="openarm_right_ee_base_link" group="right_gripper" parent_group="right_arm"/>

  <!-- the mobile base is driven by Nav2, not MoveIt -->
  <passive_joint name="left_wheel_joint"/>
  <passive_joint name="right_wheel_joint"/>
</robot>
