<?xml version="1.0" encoding="utf-8"?>
<!--
AIRLAB mobile bimanual robot. Mirrors models/airlab_robot.xml (MuJoCo):
  base_footprint -> base_link (wheel axle height) -> chassis, wheels, casters,
  lidar_link, imu_link, and openarm_body_mount -> OpenArm v2 pedestal + arms.
Keep the numbers below in sync with the MJCF.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="airlab">
  <xacro:include filename="$(find openarm_description)/assets/robot/openarm_v2.0/urdf/utils/openarm_v20_robot.xacro" />

  <xacro:property name="wheel_radius" value="0.08" />
  <xacro:property name="wheel_width" value="0.05" />
  <xacro:property name="wheel_y" value="0.225" />
  <xacro:property name="caster_radius" value="0.03" />
  <xacro:property name="caster_x" value="0.22" />
  <xacro:property name="caster_z" value="-0.047" />
  <xacro:property name="chassis_size" value="0.54 0.38 0.12" />
  <xacro:property name="chassis_z" value="0.05" />

  <material name="airlab_pink"><color rgba="0.92 0.45 0.62 1" /></material>
  <material name="airlab_black"><color rgba="0.12 0.12 0.12 1" /></material>
  <material name="airlab_grey"><color rgba="0.5 0.5 0.5 1" /></material>

  <!-- ===== mobile base ===== -->
  <link name="base_footprint" />

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_z}" />
      <geometry><box size="${chassis_size}" /></geometry>
      <material name="airlab_pink" />
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_z}" />
      <geometry><box size="${chassis_size}" /></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${chassis_z}" />
      <mass value="25.0" />
      <inertia ixx="0.33" ixy="0" ixz="0" iyy="0.64" iyz="0" izz="0.91" />
    </inertial>
  </link>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 ${wheel_radius}" />
  </joint>

  <xacro:macro name="drive_wheel" params="side y">
    <link name="${side}_wheel_link">
      <visual>
        <origin rpy="${pi/2} 0 0" />
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}" /></geometry>
        <material name="airlab_black" />
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0" />
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}" /></geometry>
      </collision>
      <inertial>
        <mass value="1.0" />
        <inertia ixx="0.0018" ixy="0" ixz="0" iyy="0.0032" iyz="0" izz="0.0018" />
      </inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="${side}_wheel_link" />
      <origin xyz="0 ${y} 0" />
      <axis xyz="0 1 0" />
    </joint>
  </xacro:macro>
  <xacro:drive_wheel side="left" y="${wheel_y}" />
  <xacro:drive_wheel side="right" y="${-wheel_y}" />

  <xacro:macro name="caster" params="name x">
    <link name="${name}_link">
      <visual>
        <geometry><sphere radius="${caster_radius}" /></geometry>
        <material name="airlab_grey" />
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link" />
      <child link="${name}_link" />
      <origin xyz="${x} 0 ${caster_z}" />
    </joint>
  </xacro:macro>
  <xacro:caster name="caster_front" x="${caster_x}" />
  <xacro:caster name="caster_rear" x="${-caster_x}" />

  <!-- 2D LiDAR: scan plane is the lidar_link xy-plane -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 -0.015" />
      <geometry><cylinder radius="0.035" length="0.04" /></geometry>
      <material name="airlab_black" />
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link" />
    <child link="lidar_link" />
    <origin xyz="0.22 0 0.13" />
  </joint>

  <!-- head camera (MJCF camera "head_camera"): x forward, pitched 0.82 rad (47 deg) down -->
  <link name="camera_link">
    <visual>
      <origin xyz="-0.02 0 0" />
      <geometry><box size="0.03 0.09 0.03" /></geometry>
      <material name="airlab_black" />
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link" />
    <child link="camera_link" />
    <origin xyz="0.05 0 0.97" rpy="0 0.82 0" />
  </joint>
  <!-- ROS optical convention: z forward, x right, y down -->
  <link name="camera_optical_frame" />
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link" />
    <child link="camera_optical_frame" />
    <origin rpy="${-pi/2} 0 ${-pi/2}" />
  </joint>

  <link name="imu_link" />
  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="0 0 0.05" />
  </joint>

  <!-- ===== OpenArm v2 pedestal + bimanual arms ===== -->
  <joint name="openarm_body_mount_joint" type="fixed">
    <parent link="base_link" />
    <child link="openarm_body_mount" />
    <origin xyz="-0.05 0 0.11" />
  </joint>

  <xacro:property name="openarm_config_root" value="$(find openarm_description)/assets/robot/openarm_v2.0/config" />
  <xacro:property name="openarm_preset" value="${xacro.load_yaml('$(find airlab_description)/config/openarm_preset.yaml')}" />
  <xacro:openarm_v20_robot
    config_root="${openarm_config_root}"
    robot_preset="${openarm_preset}"
    collapse_internal_empty_links="true"
    emit_grasp_frame="true" />
</robot>
