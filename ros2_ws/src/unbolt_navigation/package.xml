<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>unbolt_navigation</name>
  <version>0.1.0</version>
  <description>SLAM (slam_toolbox) and Nav2 configuration for the UNBOLT robot in MuJoCo.</description>
  <maintainer email="sejiny3@gmail.com">sejin</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>unbolt_mujoco_bridge</exec_depend>
  <exec_depend>unbolt_description</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
